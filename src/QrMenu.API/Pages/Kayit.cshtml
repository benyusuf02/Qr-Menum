@page
@model QrMenu.API.Pages.KayitModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kayıt Ol — QR Menü</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: system-ui, sans-serif; background: #f5f5f5; display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 24px; }
        .card { background: white; border-radius: 12px; border: 1px solid #eee; padding: 36px 32px; width: 400px; }
        .logo { text-align: center; margin-bottom: 28px; }
        .logo h1 { font-size: 22px; color: #0F6E56; }
        .logo p { font-size: 13px; color: #999; margin-top: 4px; }
        .form-group { margin-bottom: 16px; }
        .form-group label { display: block; font-size: 13px; color: #555; margin-bottom: 5px; font-weight: 500; }
        .form-group input { width: 100%; padding: 9px 12px; border: 1px solid #ddd; border-radius: 7px; font-size: 14px; outline: none; }
        .form-group input:focus { border-color: #0F6E56; }
        .hint { font-size: 12px; color: #aaa; margin-top: 4px; }
        .slug-preview { font-size: 12px; color: #0F6E56; margin-top: 4px; }
        .btn-submit { width: 100%; padding: 10px; background: #0F6E56; color: white; border: none; border-radius: 7px; font-size: 15px; font-weight: 600; cursor: pointer; margin-top: 8px; }
        .btn-submit:hover { background: #0a5240; }
        .error { background: #fee; color: #c00; border-radius: 6px; padding: 8px 12px; font-size: 13px; margin-bottom: 14px; }
        .login-link { text-align: center; margin-top: 18px; font-size: 13px; color: #888; }
        .login-link a { color: #0F6E56; text-decoration: none; font-weight: 500; }
        .login-link a:hover { text-decoration: underline; }
        .plan-badge { display: inline-block; background: #E1F5EE; color: #085041; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 8px; margin-left: 6px; vertical-align: middle; }
    </style>
</head>
<body>
    <div class="card">
        <div class="logo">
            <h1>QR Menü <span class="plan-badge">Ücretsiz</span></h1>
            <p>Restoranınız için QR menü oluşturun</p>
        </div>
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="error">@Model.ErrorMessage</div>
        }
        <form method="post">
            <div class="form-group">
                <label>Restoran Adı</label>
                <input asp-for="RestoranAdi" placeholder="Örn: Lezzet Durağı" autofocus />
            </div>
            <div class="form-group">
                <label>Menü URL'i (Slug)</label>
                <input asp-for="Slug" placeholder="lezzet-duragi" id="slugInput" />
                <div class="hint">Küçük harf, rakam ve tire kullanın.</div>
                <div class="slug-preview" id="slugPreview"></div>
            </div>
            <div class="form-group">
                <label>E-posta</label>
                <input asp-for="Email" type="email" placeholder="ornek@email.com" />
            </div>
            <div class="form-group">
                <label>Şifre</label>
                <input asp-for="Password" type="password" placeholder="En az 6 karakter" />
            </div>
            <button type="submit" class="btn-submit">Hesap Oluştur</button>
        </form>
        <div class="login-link">
            Zaten hesabınız var mı? <a href="/Auth/Login">Giriş yapın</a>
        </div>
    </div>
    <script>
        const slugInput = document.getElementById('slugInput');
        const preview = document.getElementById('slugPreview');
        slugInput.addEventListener('input', () => {
            const val = slugInput.value.trim();
            preview.textContent = val ? 'Menü linkiniz: siteniz.com/m/' + val : '';
        });
    </script>
</body>
</html>
