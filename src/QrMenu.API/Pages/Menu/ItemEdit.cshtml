@page
@model QrMenu.API.Pages.Menu.ItemEditModel
@{
    ViewData["Title"] = Model.IsNew ? "Yeni Ürün" : "Ürün Düzenle";
}

<div class="card" style="max-width:540px">
    <form method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CategoryId" />
        <div class="form-group">
            <label>Ürün Adı (TR)</label>
            <input asp-for="Name" placeholder="örn: Adana Kebap" />
        </div>
        <div class="form-group">
            <label>Açıklama (TR)</label>
            <textarea asp-for="Description" rows="2" placeholder="Kısa açıklama..."></textarea>
        </div>
        <div class="form-group">
            <label>Fiyat (₺)</label>
            <input asp-for="Price" type="number" step="0.01" />
        </div>
        <div class="form-group">
            <label>Ürün Fotoğrafı</label>
            @if (!string.IsNullOrEmpty(Model.CurrentImageUrl))
            {
                <div style="margin-bottom:8px">
                    <img src="@Model.CurrentImageUrl" alt="Mevcut Fotoğraf"
                         style="width:100px;height:100px;object-fit:cover;border-radius:8px;border:1px solid #eee" />
                    <div style="font-size:11px;color:#aaa;margin-top:4px">Mevcut fotoğraf. Değiştirmek için yeni dosya seçin.</div>
                </div>
            }
            <input asp-for="ImageFile" type="file" accept="image/jpeg,image/png,image/webp"
                   style="padding:4px 0;font-size:13px" />
            <div style="font-size:11px;color:#999;margin-top:4px">JPG, PNG veya WebP. Maksimum 5 MB.</div>
        </div>
        <div class="form-group">
            <label>Sıra</label>
            <input asp-for="SortOrder" type="number" />
        </div>
        <div class="form-group">
            <label>Durum</label>
            <select asp-for="IsAvailable">
                <option value="true">Mevcut</option>
                <option value="false">Tükendi</option>
            </select>
        </div>
        <div class="form-group">
            <label>Rozetler</label>
            <select asp-for="SelectedBadges" multiple style="height:90px">
                <option value="popular">Popüler</option>
                <option value="new">Yeni</option>
                <option value="vegan">Vegan</option>
            </select>
            <div style="font-size:11px;color:#999;margin-top:4px">Ctrl ile birden fazla seç</div>
        </div>
        <div style="display:flex;gap:8px">
            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a href="/Menu/Items?catId=@Model.CategoryId" class="btn">İptal</a>
        </div>
    </form>
</div>