@page
@model QrMenu.API.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:24px">
    <div class="card" style="margin:0">
        <div style="font-size:13px;color:#777">Toplam Ürün</div>
        <div style="font-size:32px;font-weight:700;margin-top:6px">@Model.ToplamUrun</div>
    </div>
    <div class="card" style="margin:0">
        <div style="font-size:13px;color:#777">Kategori</div>
        <div style="font-size:32px;font-weight:700;margin-top:6px">@Model.ToplamKategori</div>
    </div>
    <div class="card" style="margin:0">
        <div style="font-size:13px;color:#777">Aktif Ürün</div>
        <div style="font-size:32px;font-weight:700;margin-top:6px">@Model.AktifUrun</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.MenuUrl))
{
    <div class="card" style="margin-bottom:20px">
        <div class="card-title">🔗 Menü Linkim & QR Kodum</div>
        <div style="display:flex;gap:24px;align-items:flex-start;flex-wrap:wrap">
            <div style="flex:1;min-width:240px">
                <div style="font-size:13px;color:#777;margin-bottom:8px">Müşterilerinize bu linki paylaşın:</div>
                <div style="display:flex;gap:8px;margin-bottom:16px">
                    <code id="menuUrlText" style="flex:1;padding:8px 12px;background:#f5f5f5;border-radius:6px;font-size:13px;word-break:break-all;border:1px solid #eee">@Model.MenuUrl</code>
                    <button onclick="copyMenuUrl()" class="btn btn-primary" style="white-space:nowrap" id="copyBtn">📋 Kopyala</button>
                </div>
                <div style="display:flex;gap:8px">
                    <a href="@Model.MenuUrl" target="_blank" class="btn">👁 Menüyü Önizle</a>
                    <a href="@Model.QrImageUrl" download="@($"qr-{Model.TenantSlug}.png")" class="btn btn-primary">⬇ QR Kodunu İndir</a>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(Model.QrImageUrl))
            {
                <div style="text-align:center">
                    <img src="@Model.QrImageUrl" alt="QR Kod" style="width:140px;height:140px;border-radius:10px;border:1px solid #eee;padding:6px;background:white">
                    <div style="font-size:11px;color:#aaa;margin-top:6px">QR Kodunuz</div>
                </div>
            }
        </div>
    </div>
}

<div class="card">
    <div class="card-title">Hızlı Erişim</div>
    <a href="/Menu/Categories" class="btn btn-primary">Kategorileri Yönet</a>
    <a href="/Menu/Items" class="btn" style="margin-left:8px">Ürünleri Yönet</a>
</div>

<script>
function copyMenuUrl() {
    const url = document.getElementById('menuUrlText').textContent.trim();
    navigator.clipboard.writeText(url).then(() => {
        const btn = document.getElementById('copyBtn');
        btn.textContent = '✅ Kopyalandı';
        setTimeout(() => { btn.textContent = '📋 Kopyala'; }, 2000);
    });
}
</script>